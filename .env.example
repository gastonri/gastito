WEBHOOK_URL=https://your-app.fly.dev

TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321
TELEGRAM_PARTNER_CHAT_ID=  # opcional: chat ID de tu pareja
TELEGRAM_USER_NAMES=123456789:Gastón,987654321:Nombre  # mapeo chatId:nombre para cada usuario

DEFAULT_AI_PROVIDER=gemini  # gemini | anthropic
GEMINI_API_KEY=your_gemini_key  # usada si no se define GEMINI_API_KEYS
GEMINI_API_KEYS=key1,key2,key3  # opcional: múltiples keys separadas por coma, rota en caso de rate limit
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal  # opcional: minimal | low | medium | high (vacío = default del modelo)
GEMINI_RATE_LIMIT_COOLDOWN_MS=60000  # opcional: tiempo de cooldown por key en ms (default 60s)
GEMINI_MODEL_NAMES=gemini-3.6-flash,gemini-3.8-flash,gemini-2.5-flash  # opcional: modelos a rotar en orden de preferencia (la cuota gratis es por modelo)
GEMINI_MAX_TIMEOUTS_PER_REQUEST=3  # opcional: timeouts tolerados por mensaje antes de rendirse (default 3)
GEMINI_KEY_LABELS=cuenta principal,cuenta respaldo  # opcional: nombre de cada key, en el orden de GEMINI_API_KEYS, para los avisos al usuario
GEMINI_SLOW_KEY_COOLDOWN_MS=30000  # opcional: tras un timeout, la key pasa al final de la fila por este tiempo (default 30s)

ANTHROPIC_API_KEY=  # opcional si usás anthropic
ANTHROPIC_MODEL_NAME=claude-haiku-4-5-20251001

GOOGLE_SHEETS_SPREADSHEET_ID=1abc2def3ghi4jkl5mno6pqr
# Para desarrollo local (path al archivo JSON de service account):
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Para deploy en la nube (contenido del JSON como string, alternativa al anterior):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

REDIS_URL=redis://localhost:6379

PORT=3000
NODE_ENV=development
